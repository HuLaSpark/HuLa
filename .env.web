# Browser build: pnpm dev:web / pnpm build:web
VITE_RUNTIME=web
# Path the browser sends API requests to (same origin). The dev/preview server proxies it.
VITE_WEB_API_BASE=/api
# Dev/preview server only: where /api is forwarded, and whether the /api prefix is removed.
# HuLa-Server (gateway or BootServer) serves without the prefix; tio-chat-server serves under /api.
WEB_API_TARGET=http://127.0.0.1:18760
WEB_API_STRIP_PREFIX=true
WEB_PORT=6131
